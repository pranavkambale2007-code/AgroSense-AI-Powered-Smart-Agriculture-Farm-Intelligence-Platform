  "license": "MIT",
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "geotiff": "^3.0.5",
    "gsap": "^3.15.0",
    "motion": "^14.6.0",
    "three": "^0.186.1"
  }
}
